#!/usr/bin/env python3
"""Figure 1 v2: study-area cascade with real admin outlines."""
from __future__ import annotations

from pathlib import Path

import geopandas as gpd
import matplotlib.pyplot as plt
import matplotlib.patches as mpatches
from matplotlib.lines import Line2D
from matplotlib import font_manager
import numpy as np
import pandas as pd
from shapely.geometry import box, Point
from shapely.ops import unary_union

ROOT = Path("/workspace/apple_orchard_project")
OUT = ROOT / "outputs/revision/figures_v2"
OUT.mkdir(parents=True, exist_ok=True)
BASE = ROOT / "outputs/revision/basemaps"

# Chinese font
font_path = "/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc"
font_manager.fontManager.addfont(font_path)
plt.rcParams.update({
    "font.family": "Noto Sans CJK SC",
    "axes.unicode_minus": False,
    "figure.dpi": 150,
    "savefig.dpi": 300,
    "axes.linewidth": 0.6,
    "xtick.labelsize": 7,
    "ytick.labelsize": 7,
})

# Colors (colorblind-friendly journal palette)
C_CHINA = "#f5f5f5"
C_XJ = "#f4a261"
C_ILI = "#2a9d8f"
C_GONG = "#e76f51"
C_TRAIN_APPLE = "#d62728"
C_TRAIN_NON = "#1f77b4"
C_HOLD_APPLE = "#ff7f0e"
C_HOLD_NON = "#9467bd"
C_SENS = "#2ca02c"


def add_north_arrow(ax, x=0.92, y=0.88, size=0.08):
    ax.annotate(
        "N",
        xy=(x, y),
        xytext=(x, y - size),
        xycoords="axes fraction",
        textcoords="axes fraction",
        ha="center",
        va="center",
        fontsize=9,
        fontweight="bold",
        arrowprops=dict(arrowstyle="-|>", color="k", lw=1.2),
    )


def add_scale_bar(ax, length_km=20, location=(0.08, 0.08), height=0.015):
    """Approximate scale bar using axes CRS in degrees (lon/lat)."""
    # meters per degree lon at mid-lat
    xlim = ax.get_xlim()
    ylim = ax.get_ylim()
    mid_lat = np.mean(ylim)
    km_per_deg_lon = 111.32 * np.cos(np.deg2rad(mid_lat))
    deg = length_km / km_per_deg_lon
    x0 = xlim[0] + (xlim[1] - xlim[0]) * location[0]
    y0 = ylim[0] + (ylim[1] - ylim[0]) * location[1]
    ax.plot([x0, x0 + deg], [y0, y0], color="k", lw=2.2, solid_capstyle="butt", zorder=10)
    ax.plot([x0, x0], [y0 - (ylim[1]-ylim[0])*0.008, y0 + (ylim[1]-ylim[0])*0.008], color="k", lw=1.2, zorder=10)
    ax.plot([x0 + deg, x0 + deg], [y0 - (ylim[1]-ylim[0])*0.008, y0 + (ylim[1]-ylim[0])*0.008], color="k", lw=1.2, zorder=10)
    ax.text(x0 + deg / 2, y0 + (ylim[1]-ylim[0])*0.02, f"{length_km} km", ha="center", va="bottom", fontsize=7)


def style_axes(ax, xlabel=True, ylabel=True):
    ax.set_aspect("equal", adjustable="box")
    ax.tick_params(length=2, pad=1)
    if xlabel:
        ax.set_xlabel("经度 (°E)", fontsize=8)
    if ylabel:
        ax.set_ylabel("纬度 (°N)", fontsize=8)
    for spine in ax.spines.values():
        spine.set_linewidth(0.7)


def main():
    # --- basemaps ---
    countries = gpd.read_file(BASE / "ne_110m_admin_0/ne_110m_admin_0_countries.shp")
    china = countries[countries["ADMIN"] == "China"].to_crs(4326)
    # neighbors for context (optional light)
    neighbors = countries[countries["ADMIN"].isin(["Mongolia", "Russia", "Kazakhstan", "Kyrgyzstan", "India", "Nepal", "Bhutan", "Myanmar", "Laos", "Vietnam", "North Korea", "South Korea", "Japan", "Taiwan"])].to_crs(4326)

    admin1 = gpd.read_file(BASE / "ne_50m_admin_1/ne_50m_admin_1_states_provinces.shp")
    china_prov = admin1[admin1["admin"] == "China"].to_crs(4326)
    xinjiang = china_prov[china_prov["name"] == "Xinjiang"]

    counties = gpd.read_file(ROOT / "data/roi/Yili_county_full.geojson").to_crs(4326)
    gongliu = counties[counties["name"] == "巩留县"]
    ili_union = unary_union(counties.geometry)

    # polygons + split
    polys = gpd.read_file(ROOT / "outputs/revision/polygon_samples/user_apple_polygons_parsed.geojson")
    manifest = pd.read_csv(ROOT / "outputs/revision/polygon_samples/split_manifest_v2.csv")
    # join split/class from manifest (more complete)
    polys = polys.drop(columns=[c for c in ["split", "class_code", "county"] if c in polys.columns], errors="ignore")
    polys = polys.merge(manifest[["name", "class_code", "county", "split", "cen_lon", "cen_lat"]], on="name", how="left")
    polys = polys[polys["split"].isin(["train", "val_holdout"])].copy()
    polys = gpd.GeoDataFrame(polys, geometry="geometry", crs=4326)

    sens = pd.read_csv(ROOT / "data/interpretation_kit/Gongliu_independent_val_points.csv", usecols=["lon", "lat"])

    # Ili extent from counties
    ili_bounds = counties.total_bounds  # minx,miny,maxx,maxy
    gl_bounds = gongliu.total_bounds

    fig, axes = plt.subplots(2, 2, figsize=(10.5, 9.2), constrained_layout=False)
    fig.subplots_adjust(left=0.07, right=0.98, bottom=0.10, top=0.94, wspace=0.18, hspace=0.22)

    # ========== (a) China → Xinjiang ==========
    ax = axes[0, 0]
    neighbors.boundary.plot(ax=ax, linewidth=0.3, color="#cccccc", zorder=0)
    china.plot(ax=ax, facecolor=C_CHINA, edgecolor="#444444", linewidth=0.6, zorder=1)
    china_prov.boundary.plot(ax=ax, linewidth=0.25, color="#bbbbbb", zorder=2)
    xinjiang.plot(ax=ax, facecolor=C_XJ, edgecolor="#9a3412", linewidth=0.9, alpha=0.92, zorder=3)
    # Ili inset marker as small rectangle
    minx, miny, maxx, maxy = ili_bounds
    ax.add_patch(mpatches.Rectangle((minx, miny), maxx - minx, maxy - miny,
                                    fill=False, edgecolor=C_ILI, linewidth=1.4, zorder=4))
    ax.annotate("新疆", xy=(87, 41.5), fontsize=9, fontweight="bold", color="#7c2d12", ha="center")
    ax.annotate("伊犁", xy=((minx + maxx) / 2, maxy + 1.2), fontsize=7.5, color=C_ILI, ha="center",
                arrowprops=dict(arrowstyle="-", color=C_ILI, lw=0.7),
                xytext=((minx + maxx) / 2, maxy + 3.5))
    ax.set_xlim(72, 136)
    ax.set_ylim(17, 55)
    ax.set_title("(a) 中国 · 新疆位置", fontsize=10, fontweight="bold", loc="left", pad=4)
    style_axes(ax)
    add_north_arrow(ax, 0.90, 0.90, 0.07)

    # ========== (b) Xinjiang → Ili ==========
    ax = axes[0, 1]
    xinjiang.plot(ax=ax, facecolor="#fff7ed", edgecolor="#9a3412", linewidth=0.9, zorder=1)
    # other provinces lightly for context
    china_prov.boundary.plot(ax=ax, linewidth=0.3, color="#dddddd", zorder=0)
    counties.plot(ax=ax, facecolor=C_ILI, edgecolor="#0f766e", linewidth=0.5, alpha=0.85, zorder=2)
    gongliu.plot(ax=ax, facecolor=C_GONG, edgecolor="#7c2d12", linewidth=0.9, alpha=0.95, zorder=3)
    xb = xinjiang.total_bounds
    pad = 1.0
    ax.set_xlim(xb[0] - pad, xb[2] + pad)
    ax.set_ylim(xb[1] - pad, xb[3] + pad)
    ax.annotate("伊犁河谷县区", xy=((minx + maxx) / 2, (miny + maxy) / 2),
                fontsize=8, color="white", ha="center", va="center", fontweight="bold",
                path_effects=None)
    # label Gongliu
    gcx = gongliu.geometry.centroid.iloc[0]
    ax.annotate("巩留", xy=(gcx.x, gcx.y), xytext=(gcx.x + 2.5, gcx.y - 1.8),
                fontsize=8, color=C_GONG, fontweight="bold",
                arrowprops=dict(arrowstyle="->", color=C_GONG, lw=0.9))
    ax.set_title("(b) 新疆 · 伊犁河谷", fontsize=10, fontweight="bold", loc="left", pad=4)
    style_axes(ax)
    add_north_arrow(ax, 0.90, 0.90, 0.07)
    leg_b = [
        mpatches.Patch(facecolor=C_ILI, edgecolor="#0f766e", label="伊犁11县市"),
        mpatches.Patch(facecolor=C_GONG, edgecolor="#7c2d12", label="巩留县"),
    ]
    ax.legend(handles=leg_b, loc="lower left", fontsize=7, frameon=True, fancybox=False,
              edgecolor="#cccccc", framealpha=0.95)

    # ========== (c) Ili 11 counties, Gongliu highlight ==========
    ax = axes[1, 0]
    counties.plot(ax=ax, facecolor="#e8f5f3", edgecolor="#555555", linewidth=0.55, zorder=1)
    gongliu.plot(ax=ax, facecolor=C_GONG, edgecolor="#7c2d12", linewidth=1.1, alpha=0.9, zorder=2)
    # county labels (short)
    for _, row in counties.iterrows():
        c = row.geometry.representative_point()
        name = row["name"].replace("察布查尔锡伯自治县", "察布查尔").replace("霍尔果斯市", "霍尔果斯").replace("可克达拉市", "可克达拉")
        weight = "bold" if row["name"] == "巩留县" else "normal"
        color = "white" if row["name"] == "巩留县" else "#333333"
        ax.text(c.x, c.y, name, fontsize=6.2 if row["name"] != "巩留县" else 7.5,
                ha="center", va="center", color=color, fontweight=weight, zorder=5)
    # train centroids outside Gongliu as tiny markers for context
    train = polys[polys["split"] == "train"]
    hold = polys[polys["split"] == "val_holdout"]
    for cls, color, marker in [(1, C_TRAIN_APPLE, "o"), (0, C_TRAIN_NON, "s")]:
        sub = train[train["class_code"] == cls]
        if len(sub):
            ax.scatter(sub.geometry.centroid.x, sub.geometry.centroid.y, s=18, c=color,
                       marker=marker, edgecolors="white", linewidths=0.4, zorder=6, alpha=0.95)
    for cls, color, marker in [(1, C_HOLD_APPLE, "^"), (0, C_HOLD_NON, "D")]:
        sub = hold[hold["class_code"] == cls]
        if len(sub):
            ax.scatter(sub.geometry.centroid.x, sub.geometry.centroid.y, s=28, c=color,
                       marker=marker, edgecolors="white", linewidths=0.5, zorder=7, alpha=0.95)

    pad_c = 0.15
    ax.set_xlim(ili_bounds[0] - pad_c, ili_bounds[2] + pad_c)
    ax.set_ylim(ili_bounds[1] - pad_c, ili_bounds[3] + pad_c)
    ax.set_title("(c) 伊犁11县市 · 巩留高亮", fontsize=10, fontweight="bold", loc="left", pad=4)
    style_axes(ax)
    add_north_arrow(ax, 0.92, 0.92, 0.06)
    add_scale_bar(ax, length_km=50, location=(0.06, 0.07))
    leg_c = [
        Line2D([0], [0], marker="o", color="w", markerfacecolor=C_TRAIN_APPLE, markersize=6, label="训练·苹果园"),
        Line2D([0], [0], marker="s", color="w", markerfacecolor=C_TRAIN_NON, markersize=6, label="训练·非果园"),
        Line2D([0], [0], marker="^", color="w", markerfacecolor=C_HOLD_APPLE, markersize=7, label="Holdout·苹果园"),
        Line2D([0], [0], marker="D", color="w", markerfacecolor=C_HOLD_NON, markersize=6, label="Holdout·非果园"),
    ]
    ax.legend(handles=leg_c, loc="lower right", fontsize=6.5, frameon=True, fancybox=False,
              edgecolor="#cccccc", framealpha=0.95, ncol=1)

    # ========== (d) Gongliu focus: polys + sensitivity ==========
    ax = axes[1, 1]
    # slightly expanded to include nearby train if any near border; primarily Gongliu
    # Use Gongliu bounds with padding; also include all holdout + train centroids that fall near
    gongliu.plot(ax=ax, facecolor="#fafafa", edgecolor="#7c2d12", linewidth=1.2, zorder=1)
    # plot polygon outlines by split×class
    styles = {
        ("train", 1): dict(facecolor=C_TRAIN_APPLE, edgecolor="#7f1d1d", alpha=0.45, linewidth=0.7, label="训练·苹果园"),
        ("train", 0): dict(facecolor=C_TRAIN_NON, edgecolor="#1e3a5f", alpha=0.40, linewidth=0.7, label="训练·非果园"),
        ("val_holdout", 1): dict(facecolor=C_HOLD_APPLE, edgecolor="#9a3412", alpha=0.55, linewidth=0.9, label="Holdout·苹果园"),
        ("val_holdout", 0): dict(facecolor=C_HOLD_NON, edgecolor="#4c1d95", alpha=0.50, linewidth=0.9, label="Holdout·非果园"),
    }
    for (spl, cls), sty in styles.items():
        sub = polys[(polys["split"] == spl) & (polys["class_code"] == cls)]
        # clip display to near Gongliu for train (most train outside)
        if spl == "train":
            # only show if intersects Gongliu buffer
            buf = gongliu.geometry.iloc[0].buffer(0.35)
            sub = sub[sub.intersects(buf)]
        if len(sub):
            sub.plot(ax=ax, zorder=3, **{k: v for k, v in sty.items() if k != "label"})

    # 600 sensitivity points
    ax.scatter(sens["lon"], sens["lat"], s=4, c=C_SENS, marker=".", alpha=0.55,
               linewidths=0, zorder=4, label="目视敏感性 600点")

    # zoom: Gongliu + small pad; if holdout east cluster, ensure included
    pad_d = 0.05
    ax.set_xlim(gl_bounds[0] - pad_d, gl_bounds[2] + pad_d)
    ax.set_ylim(gl_bounds[1] - pad_d, gl_bounds[3] + pad_d)
    ax.set_title("(d) 巩留：Holdout园块与目视敏感性点", fontsize=10, fontweight="bold", loc="left", pad=4)
    style_axes(ax)
    add_north_arrow(ax, 0.92, 0.92, 0.06)
    add_scale_bar(ax, length_km=20, location=(0.06, 0.07))

    # fixed combined legend under panel (d) / figure
    legend_handles = [
        mpatches.Patch(facecolor=C_TRAIN_APPLE, edgecolor="#7f1d1d", alpha=0.6, label="训练·苹果园面"),
        mpatches.Patch(facecolor=C_TRAIN_NON, edgecolor="#1e3a5f", alpha=0.55, label="训练·非果园面"),
        mpatches.Patch(facecolor=C_HOLD_APPLE, edgecolor="#9a3412", alpha=0.7, label="Holdout·苹果园面（主验证）"),
        mpatches.Patch(facecolor=C_HOLD_NON, edgecolor="#4c1d95", alpha=0.65, label="Holdout·非果园面（主验证）"),
        Line2D([0], [0], marker=".", color="w", markerfacecolor=C_SENS, markersize=10, label="目视敏感性点（辅，n=600）"),
    ]
    ax.legend(handles=legend_handles, loc="upper left", fontsize=6.2, frameon=True,
              fancybox=False, edgecolor="#cccccc", framealpha=0.95, title="样本图例", title_fontsize=7)

    fig.suptitle("图1  研究区嵌套定位与独立验证样本分布", fontsize=12, fontweight="bold", y=0.985)

    out_png = OUT / "fig01_study_area_v2.png"
    fig.savefig(out_png, dpi=300, bbox_inches="tight", facecolor="white")
    fig.savefig(OUT / "fig01_study_area_v2.pdf", bbox_inches="tight", facecolor="white")
    plt.close(fig)
    print("Wrote", out_png, "size", out_png.stat().st_size)


if __name__ == "__main__":
    main()
